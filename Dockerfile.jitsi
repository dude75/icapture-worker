FROM node:22-bookworm-slim

WORKDIR /app

ENV HOST=0.0.0.0 \
    PORT=8001 \
    DATA_DIR=/data \
    NODE_ENV=production \
    SDP_SEMANTICS=plan-b \
    FFMPEG_MP3_VBR_QUALITY=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY node/jitsi/package.json ./package.json
RUN npm install --omit=dev

COPY node/jitsi ./

RUN set -eux; \
    if ! getent group 1001 >/dev/null; then groupadd --gid 1001 app; fi; \
    if ! getent passwd 1001 >/dev/null; then \
        useradd --uid 1001 --gid 1001 --create-home --home-dir /home/app --shell /usr/sbin/nologin app; \
    fi; \
    mkdir -p /data/artifacts; \
    chown -R 1001:1001 /app /data

USER 1001:1001

EXPOSE 8001
VOLUME ["/data"]

CMD ["node", "server.js"]
