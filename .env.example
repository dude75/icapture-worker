# =============================================================================
# icapture-worker — `python -m app.serve` (pydantic-settings reads this file)
# =============================================================================
API_TOKEN=change-me
HOST=0.0.0.0
# HTTP port (local dev and Docker Compose host↔container publish, e.g. PORT=9000 → :9000/:9000)
PORT=8000

DATA_DIR=./data
SQLITE_PATH=./data/tasks.db
LOG_DIR=./data/logs
LOG_LEVEL=info

WORKERS=4
# Extra queued accepts beyond WORKERS (0 = hub dispatch uses workers.* only)
WORKER_QUEUE_SIZE=0
ENABLED_CONNECTORS=jitsi
# ENABLED_CONNECTORS=jitsi,telemost

# Auto-finalize capture (same as POST /tasks/{id}/stop): max duration, kick, leave/disconnect
MAX_CAPTURE_DURATION_SEC=14400
CAPTURE_FINALIZE_TIMEOUT_SEC=120
TASK_TTL_SEC=3600
DEFAULT_BOT_DISPLAY_NAME="Transcription Bot"

METRICS_ENABLED=true
METRICS_TOKEN=change-me-scrape-token

ARTIFACT_SAMPLE_RATE=44100
FFMPEG_MP3_VBR_QUALITY=2

# Playwright / Chromium capture
PLAYWRIGHT_HEADLESS=true
# Max time to reach in-meeting state (Jitsi prejoin / moderator wait, Telemost waiting room)
CONF_JOIN_TIMEOUT_SEC=180

# Yandex Telemost (when enabled in ENABLED_CONNECTORS)
# TELEMOST_STORAGE_STATE=./data/telemost-auth.json
TELEMOST_CDP_GRANT=true
TELEMOST_GUM_FALLBACK=true
