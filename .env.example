# =============================================================================
# Shared (Python API + Node engine must use the same DATA_DIR)
# =============================================================================
DATA_DIR=./data

# =============================================================================
# Python API — `python -m app.serve` (reads this file via pydantic-settings)
# =============================================================================
API_TOKEN=change-me
HOST=0.0.0.0
PORT=8000

SQLITE_PATH=./data/tasks.db
LOG_DIR=./data/logs
LOG_LEVEL=info

MAX_CONCURRENT_CAPTURES=2
MAX_CAPTURE_DURATION_SEC=14400
TASK_TTL_SEC=3600
DEFAULT_BOT_DISPLAY_NAME=Transcription Bot

METRICS_ENABLED=true
METRICS_TOKEN=change-me-scrape-token

# URL of the Node sidecar (see block below)
JITSI_ENGINE_URL=http://127.0.0.1:8001
JITSI_ENGINE_TIMEOUT_SEC=120

# Validate .m4a after capture (must match Node/ffmpeg output: 44.1 kHz AAC)
ARTIFACT_SAMPLE_RATE=44100
FFMPEG_AAC_VBR_QUALITY=2

# =============================================================================
# Node Jitsi engine — `cd node/jitsi && npm start`
# Does not load .env automatically; export these or pass inline when starting.
# =============================================================================
# HOST=127.0.0.1
# PORT=8001
# DATA_DIR=./data
# FFMPEG_AAC_VBR_QUALITY=2
# SDP_SEMANTICS=plan-b

# =============================================================================
# Dev / tests only — not for production
# =============================================================================
# ICAPTURE_STUBS=1   → Python fakes capture; Node not needed
# JITSI_STUB=1       → Node fakes Jitsi join (no WebRTC)
