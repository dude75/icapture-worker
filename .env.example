# =============================================================================
# icapture-worker — `python -m app.serve` (pydantic-settings reads this file)
# =============================================================================
API_TOKEN=change-me
HOST=0.0.0.0
PORT=8000
# Docker Compose: host port published to the machine (uvicorn in container stays on 8000)
# HOST_PORT=9000

DATA_DIR=./data
SQLITE_PATH=./data/tasks.db
LOG_DIR=./data/logs
LOG_LEVEL=info

WORKERS=4
# Extra queued accepts beyond WORKERS (0 = hub dispatch uses workers.* only)
WORKER_QUEUE_SIZE=0
ENABLED_CONNECTORS=jitsi

# Auto-finalize capture (same as POST /tasks/{id}/stop): max duration, kick, leave/disconnect
MAX_CAPTURE_DURATION_SEC=14400
CAPTURE_FINALIZE_TIMEOUT_SEC=120
TASK_TTL_SEC=3600
DEFAULT_BOT_DISPLAY_NAME="Transcription Bot"

METRICS_ENABLED=true
METRICS_TOKEN=change-me-scrape-token

ARTIFACT_SAMPLE_RATE=44100
FFMPEG_MP3_VBR_QUALITY=2

# Playwright / Chromium capture
PLAYWRIGHT_HEADLESS=true
